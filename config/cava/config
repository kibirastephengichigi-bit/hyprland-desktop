# Cava Configuration

[general]
framerate = 60
autosens = 1
sensitivity = 100
channels = stereo
mono = false
reverse = false
bar_delimiter = 59
input = pulseaudio
method = fftw
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[output]
method = ncurses
charset = utf8
color_scheme = default
background = default
foreground = cyan

[color]
gradient = 1
gradient_color_1 = "#89b4fa"
gradient_color_2 = "#a6e3a1"
gradient_color_3 = "#f9e2af"

[smoothing]
monstercat = 0
waves = 0
noise_reduction = 0.77
