/* Rofi Configuration */

configuration {
    show-icons: true;
    display-drun: " Application";
    display-run: " Run";
    display-window: " Window";
    display-combi: " Combi";
    drun-display-format: "{icon} {name}";
}

@theme "~/.config/rofi/themes/catppuccin"

window {
    width: 50%;
    height: 50%;
    border: 2px;
    border-color: #89b4fa;
    background-color: #1e1e2e;
    border-radius: 8px;
}

mainbox {
    background-color: #1e1e2e;
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 15px;
}

inputbar {
    background-color: #313244;
    border-radius: 8px;
    padding: 8px 12px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: #89b4fa;
}

entry {
    text-color: #cdd6f4;
    placeholder-color: #6c7086;
}

listview {
    lines: 10;
    columns: 1;
    background-color: transparent;
}

element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: #cdd6f4;
    border-radius: 8px;
}

element.selected {
    background-color: #313244;
    text-color: #89b4fa;
}

element-icon {
    size: 24px;
}
